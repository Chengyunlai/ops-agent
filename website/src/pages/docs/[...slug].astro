---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Layout from "@/layouts/Layout.astro";
import config from "@/config";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages
    .filter(page => page.id !== "about")
    .map(page => ({ params: { slug: page.id }, props: { page } }));
}

type Props = { page: CollectionEntry<"pages"> };
const { page } = Astro.props;
const { Content } = await render(page);
---

<Layout
  title={`${page.data.title} | ${config.site.title}`}
  description={page.data.description}
  ogImage={page.data.ogImage}
  canonicalURL={page.data.canonicalURL}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={page.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
